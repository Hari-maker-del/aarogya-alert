# Copy to .env if using a shell that loads environment files, or export these variables.
AAROGYA_DATABASE_PATH=data/aarogya_alert.db
AAROGYA_CSV_PATH=data/synthetic_observations.csv
AAROGYA_CORS_ORIGINS=http://localhost:5173
AAROGYA_SMALL_COUNT_THRESHOLD=5
AAROGYA_ANOMALY_THRESHOLD=3.5
AAROGYA_DETECTION_LOOKBACK_DAYS=7

# Optional durable reviewer workflow integration.
# For isolated staging, use the staging project's URL/key and schema below.
# The Supabase API must expose the configured schema in Project Settings > API.
AAROGYA_SUPABASE_URL=
AAROGYA_SUPABASE_PUBLISHABLE_KEY=
AAROGYA_SUPABASE_SCHEMA=public
